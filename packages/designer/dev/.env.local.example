# Copy this file to .env.local (gitignored — see root .gitignore) to run the
# designer dev harness against a REAL unidb engine instead of the built-in
# StaticAdapter demo fixture. See memory.md D-076 for the full story.
#
# 1. Start the engine (separate repo — not part of this monorepo):
#      cd ../../unidb   # or wherever you cloned it
#      UNIDB_JWT_SECRET=dev-secret UNIDB_BIND_ADDR=127.0.0.1:8080 \
#        cargo run --bin unidb-server --features server
#
# 2. Mint a dev token from that same repo:
#      TOKEN=$(UNIDB_JWT_SECRET=dev-secret ./scripts/gen_jwt.sh)
#
# 3. Fill in the values below, then run:
#      pnpm --filter @docsmith/designer dev:unidb

VITE_ADAPTER=unidb
VITE_UNIDB_URL=http://localhost:8080
VITE_UNIDB_TOKEN=
