{
  "name": "@docsmith/designer",
  "version": "0.0.0",
  "description": "The <doc-designer> custom element: a browser-embeddable, drag-and-drop document template designer.",
  "type": "module",
  "main": "./dist/doc-designer.js",
  "module": "./dist/doc-designer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/doc-designer.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "svelte": "^5.0.0",
    "@docsmith/core": "workspace:*",
    "@docsmith/adapters": "workspace:*"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0",
    "@testing-library/svelte": "^5.2.0",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.0",
    "eslint-plugin-svelte": "^2.44.0",
    "svelte-eslint-parser": "^0.41.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0"
  }
}
