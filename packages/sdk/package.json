{
  "name": "@docsmith/sdk",
  "version": "0.0.0",
  "description": "Plug-and-play embedding SDK: mount the designer, preview client-side, request PDFs.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@docsmith/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
